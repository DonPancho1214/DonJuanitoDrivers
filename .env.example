# API key de Groq para el chatbot (Don Juanito)
VITE_GROQ_API_KEY=your_groq_api_key_here

# Bot de Telegram para notificaciones de agendamiento
VITE_TELEGRAM_TOKEN=your_telegram_bot_token_here
VITE_TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Google Places API para reseñas reales
VITE_GOOGLE_API_KEY=your_google_api_key_here
VITE_GOOGLE_PLACE_ID=your_google_place_id_here

# Supabase (sistema de reseñas propio)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
